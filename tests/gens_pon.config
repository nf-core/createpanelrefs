process {
    withName: GATK4_CREATEREADCOUNTPANELOFNORMALS {
        ext.args = "--minimum-interval-median-percentile 10 --number-of-eigensamples 2"
    }
}

profiles {
    docker {
        process {
            withName: GATK4_CREATEREADCOUNTPANELOFNORMALS {
                // Spark looks up the user name, so the calling uid must exist in the container
                containerOptions = '-v /etc/passwd:/etc/passwd:ro -v /etc/group:/etc/group:ro'
            }
        }
    }
}
