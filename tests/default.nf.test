def projectDir = new File('.').absolutePath

nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline_createpanelrefs"

    def test_scenario = [
        [
            name: "-profile test --tools cnvkit --input tests/csv/1.0.0/bam_cram.csv",
            params: [
                input: "${projectDir}/tests/csv/1.0.0/bam_cram.csv",
                tools: 'cnvkit',
            ],
        ],
        [
            name: "-profile test --tools cnvkit --cnvkit_targets multi_intervals.bed --cnvkit_annotate chr21_gencode.gtf",
            params: [
                cnvkit_annotate: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/sequence/chr21_gencode.gtf',
                cnvkit_targets: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/sequence/multi_intervals.bed',
                tools: 'cnvkit',
            ],
        ],
        [
            name: "-profile test --tools cnvkit --cnvkit_annotate chr21_gencode.gtf",
            params: [
                cnvkit_annotate: 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/chr21/sequence/chr21_gencode.gtf',
                tools: 'cnvkit',
            ],
            failure: true,
            snapshot: 'stdout',
            snapshot_include: 'cnvkit_targets',
        ],
        [
            name: "-profile test --tools cnvkit --cnvkit_pon_name null",
            params: [
                cnvkit_pon_name: null,
                tools: 'cnvkit',
            ],
            failure: true,
            snapshot: 'stdout',
            snapshot_include: 'cnvkit_pon_name',
        ],
    ]

    // Generate tests for each scenario
    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getTest(scenario))
    }
}
